# Copy to .env and fill in. .env is gitignored — never commit real keys.

PORT=4000

# Comma-separated list of frontends allowed to call this API.
ALLOWED_ORIGINS=http://localhost:3000

# Optional: leave RESEND_API_KEY blank and contact messages are just logged
# to the console, which is fine for local development.
RESEND_API_KEY=
CONTACT_TO_EMAIL=ai.altatech@gmail.com
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Chatbot. Leave GROQ_API_KEY blank and the widget replies with a fallback
# pointing at the contact email instead — nothing to configure locally.
# Free key (with rate limits) at https://console.groq.com/keys
GROQ_API_KEY=
