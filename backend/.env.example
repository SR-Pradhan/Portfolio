# Copy to .env and fill in. .env is gitignored — never commit real keys.

PORT=4000

# Comma-separated list of frontends allowed to call this API.
ALLOWED_ORIGINS=http://localhost:3000

# Optional: leave RESEND_API_KEY blank and contact messages are just logged
# to the console, which is fine for local development.
RESEND_API_KEY=
CONTACT_TO_EMAIL=ai.altatech@gmail.com
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Chatbot. Leave GROQ_API_KEY blank and the widget replies with a fallback
# pointing at the contact email instead — nothing to configure locally.
# Free key (with rate limits) at https://console.groq.com/keys
GROQ_API_KEY=

# GitHub data. The project-card stats work without a token, on GitHub's 60
# requests per hour per IP, which the 30-minute cache keeps well inside.
#
# The contribution heatmap does need one: contribution counts exist only in
# GitHub's GraphQL API, which rejects anonymous calls. Without a token the
# heatmap section is absent from the page rather than empty.
#
# A classic token with NO scopes ticked is enough for both.
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Durable counters for the "this site" panel. Optional but strongly advised in
# production: without these the counts live in a JSON file on the instance's
# disk, and a free tier hands you a fresh container on every deploy and after
# ~15 idle minutes — so the panel reads zero most of the time.
#
# Free database at https://console.upstash.com (Redis → REST API section).
#
# Use the plain token, NOT the read-only one: the counters are written, not
# just read. A read-only token fails in a way that is easy to miss — Upstash
# answers HTTP 200 with a per-command error, so the writes vanish and the panel
# simply reads zero.
#
# To check it took: GET /api/metrics reports `store.ok` and `store.lastError`.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
