# Copy to .env.local and adjust. .env.local is gitignored.

# Where the backend API lives. In production this becomes your deployed
# API URL, e.g. https://portfolio-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# Canonical origin, used by the metadata, OG tags, JSON-LD, sitemap and
# robots.txt. MUST be set in production: the fallback in site.ts is a guess
# and does not resolve, so leaving it unset publishes a canonical URL that 404s.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
